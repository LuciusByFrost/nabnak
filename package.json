{
  "name": "nabnak",
  "version": "1.0.0",
  "private": true,
  "description": "Static Kanban, calendar, goals and mind maps. No runtime dependencies.",
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.cjs",
    "test:browser": "node tests/browser/validate.cjs",
    "test:themes": "node tests/browser/themes.cjs",
    "serve": "node tools/serve.cjs",
    "test:security:browser": "node tests/browser/security.cjs",
    "test:secrets": "node tools/scan-secrets.cjs"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "engines": {
    "node": ">=24"
  }
}
